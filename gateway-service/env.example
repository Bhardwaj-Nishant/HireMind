DATABASE_URL=postgresql+psycopg2://hiremind:hiremind@localhost:5432/hiremind

# for POST /matches/refresh (shared/ingestion -> Firecrawl, LinkedIn)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
INTERNSHALA_REQUEST_DELAY=2
# LinkedIn session must be created once via `python scripts/linkedin_setup.py`
# in ingestion-service/ — gateway-service reads that same session file.
LINKEDIN_SESSION_PATH=../ingestion-service/linkedin_session.json
LINKEDIN_MIN_INTERVAL_HOURS=1

# for POST /matches/{id}/generate (shared/generation -> shared/llm)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5
RESUME_PATH=../intelligence-service/resume.txt

# for POST /drafts/{id}/push-to-gmail (shared/gmail)
GOOGLE_CLIENT_SECRETS_PATH=../ingestion-service/client_secrets.json
