FIRECRAWL_API_KEY=your_firecrawl_api_key_here
DATABASE_URL=postgresql+psycopg2://hiremind:hiremind@localhost:5432/hiremind
INTERNSHALA_REQUEST_DELAY=2
UNSTOP_REQUEST_DELAY=2

# LinkedIn (unofficial, session-cookie based — see
# shared/ingestion/sources/linkedin.py docstring for setup steps and caveats)
# Only needed for the FIRST run — after that, cookies are stored in the
# credentials table and reused automatically.
LINKEDIN_LI_AT=your_li_at_cookie_value
LINKEDIN_JSESSIONID=your_jsessionid_cookie_value
LINKEDIN_MIN_INTERVAL_HOURS=1
LINKEDIN_REQUEST_DELAY=2

# Gmail OAuth (see app/gmail/auth.py docstring for setup steps)
GOOGLE_CLIENT_SECRETS_PATH=./client_secrets.json

# LLM provider — used for Gmail importance classification AND for
# deriving Internshala search keywords from your resume (shared/llm)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Only needed if resume.txt isn't at the default location (../intelligence-service/resume.txt)
RESUME_PATH=../intelligence-service/resume.txt
