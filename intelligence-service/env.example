# Choose which LLM backend matcher.py uses: 'groq' (free) or 'claude' (paid)
LLM_PROVIDER=groq

# Groq (free tier) — get a key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Claude (paid) — get a key at console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

DATABASE_URL=postgresql+psycopg2://hiremind:hiremind@localhost:5432/hiremind
RESUME_PATH=./resume.txt
